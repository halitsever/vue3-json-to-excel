{
  "name": "vue3-json-to-excel",
  "version": "1.0.1",
  "description": "Vue 3 component that exports a JSON object to an Excel (.xlsx) file in the browser, built on SheetJS.",
  "main": "dist/vue3-json-to-excel.ssr.js",
  "browser": "dist/vue3-json-to-excel.esm.js",
  "module": "dist/vue3-json-to-excel.esm.js",
  "unpkg": "dist/vue3-json-to-excel.min.js",
  "bugs": {
    "url": "https://github.com/halitsever/vue3-json-to-excel/issues"
  },
  "homepage": "https://github.com/halitsever/vue3-json-to-excel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halitsever/vue3-json-to-excel.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "json",
    "excel",
    "xlsx",
    "json-to-excel",
    "json-to-xlsx",
    "export-excel",
    "excel-export",
    "spreadsheet",
    "sheetjs"
  ],
  "author": "Halit Sever",
  "license": "MIT",
  "files": [
    "dist/*",
    "src/**/*.vue"
  ],
  "sideEffects": false,
  "scripts": {
    "serve": "vite",
    "prebuild": "rimraf ./dist",
    "build": "cross-env NODE_ENV=production rollup --config build/rollup.config.mjs",
    "build:ssr": "cross-env NODE_ENV=production rollup --config build/rollup.config.mjs --format cjs",
    "build:es": "cross-env NODE_ENV=production rollup --config build/rollup.config.mjs --format es",
    "build:unpkg": "cross-env NODE_ENV=production rollup --config build/rollup.config.mjs --format iife"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/compiler-sfc": "^3.5.45",
    "cross-env": "^10.1.0",
    "minimist": "^1.2.8",
    "postcss": "^8.5.33",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue": "^6.0.0",
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "vue": "^3.0.5"
  },
  "engines": {
    "node": ">=12"
  }
}
