{
  "name": "vue3-json-to-excel",
  "version": "1.1.0",
  "description": "Vue 3 component that exports JSON to an Excel (.xlsx) file in the browser, built on SheetJS. Try it in the online JSON to Excel converter.",
  "main": "dist/vue3-json-to-excel.cjs",
  "module": "dist/vue3-json-to-excel.mjs",
  "types": "types/index.d.ts",
  "unpkg": "dist/vue3-json-to-excel.min.js",
  "jsdelivr": "dist/vue3-json-to-excel.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/vue3-json-to-excel.mjs",
      "require": "./dist/vue3-json-to-excel.cjs"
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/halitsever/vue3-json-to-excel/issues"
  },
  "homepage": "https://projects.halit.org/vue3-json-to-excel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halitsever/vue3-json-to-excel.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-component",
    "json",
    "excel",
    "xlsx",
    "json-to-excel",
    "json-to-xlsx",
    "json-to-excel-converter",
    "vue-excel",
    "vue-export-excel",
    "export-excel",
    "excel-export",
    "spreadsheet",
    "sheetjs"
  ],
  "author": "Halit Sever",
  "license": "MIT",
  "files": [
    "dist",
    "types"
  ],
  "sideEffects": false,
  "scripts": {
    "serve": "vite",
    "preserve:site": "npm run build",
    "serve:site": "vite --config vite.site.config.mjs",
    "build": "vite build --config build/vite.lib.config.mjs && vite build --config build/vite.lib.config.mjs --mode single",
    "prebuild:site": "npm run build",
    "build:site": "vite build --config vite.site.config.mjs",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "vite": "^8.4.0",
    "vue": "^3.5.46",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  }
}
